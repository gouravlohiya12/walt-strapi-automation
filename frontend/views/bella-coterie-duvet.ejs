<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= page.seo?.meta_title || page.title %></title>
  <meta name="description" content="<%= page.seo?.meta_description || '' %>">
  <link rel="canonical" href="<%= baseUrl %>/<%= page.slug %>">
  <meta name="robots" content="index, follow">

  <!-- Open Graph -->
  <meta property="og:title" content="<%= page.seo?.meta_title || page.title %>">
  <meta property="og:description" content="<%= page.seo?.meta_description || '' %>">
  <meta property="og:url" content="<%= baseUrl %>/<%= page.slug %>">
  <meta property="og:type" content="product">
  <meta property="og:image" content="<%= page.content.hero.product_image %>">
  <meta property="product:price:amount" content="119.99">
  <meta property="product:price:currency" content="USD">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= page.seo?.meta_title || page.title %>">
  <meta name="twitter:description" content="<%= page.seo?.meta_description || '' %>">
  <meta name="twitter:image" content="<%= page.content.hero.product_image %>">

  <link rel="icon" href="<%= client.favicon || '' %>" type="image/png">

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,400;1,500;1,600;1,700&family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <!-- Product Schema -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "Bella Coterie Luxury Bamboo Duvet Cover Set",
    "description": "<%= page.seo?.meta_description || '' %>",
    "image": "<%= page.content.hero.product_image %>",
    "brand": { "@type": "Brand", "name": "Bella Coterie" },
    "offers": {
      "@type": "AggregateOffer",
      "lowPrice": "119.99",
      "highPrice": "129.99",
      "priceCurrency": "USD",
      "availability": "https://schema.org/InStock",
      "offerCount": "3"
    },
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "5",
      "reviewCount": "5000",
      "bestRating": "5"
    }
  }
  </script>

  <!-- FAQ Schema -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      <% page.content.faq.items.forEach(function(item, i) { %>
      {
        "@type": "Question",
        "name": "<%= item.q.replace(/"/g, '\\"') %>",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "<%= item.a.replace(/"/g, '\\"') %>"
        }
      }<%= i < page.content.faq.items.length - 1 ? ',' : '' %>
      <% }); %>
    ]
  }
  </script>

  <style>
    :root {
      --bc-primary: <%= client.colors.primary %>;
      --bc-accent: <%= client.colors.accent %>;
      --bc-secondary: <%= client.colors.secondary %>;
      --bc-bg: <%= client.colors.background %>;
      --bc-text: <%= client.colors.text %>;
      --bc-white: #FFFFFF;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'Montserrat', 'Proxima Nova', system-ui, sans-serif;
      color: var(--bc-text);
      background: var(--bc-bg);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
    }

    h1, h2, h3, h4, .font-display {
      font-family: 'Playfair Display', Georgia, serif;
      line-height: 1.15;
      font-weight: 700;
      color: var(--bc-primary);
    }

    .container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
    .container-narrow { max-width: 900px; margin: 0 auto; padding: 0 24px; }

    /* ── Promo Banner ── */
    .promo-banner {
      background: var(--bc-primary);
      color: var(--bc-white);
      text-align: center;
      padding: 12px 20px;
      font-size: 14px;
      font-weight: 500;
      letter-spacing: 0.05em;
    }
    .promo-banner .promo-code {
      background: var(--bc-accent);
      color: var(--bc-white);
      padding: 2px 10px;
      border-radius: 4px;
      font-weight: 700;
      margin-left: 8px;
    }

    /* ── Nav ── */
    .bc-nav {
      background: var(--bc-white);
      padding: 16px 0;
      border-bottom: 1px solid rgba(0,0,0,0.06);
      position: sticky;
      top: 0;
      z-index: 100;
    }
    .bc-nav .container {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .bc-nav img { height: 32px; width: auto; }
    .nav-cta {
      background: var(--bc-primary);
      color: var(--bc-white);
      padding: 12px 28px;
      border-radius: 40px;
      font-size: 13px;
      font-weight: 600;
      text-decoration: none;
      letter-spacing: 0.03em;
      transition: opacity 0.2s;
    }
    .nav-cta:hover { opacity: 0.85; }

    /* ── Hero ── */
    .hero {
      background: var(--bc-secondary);
      padding: 80px 0 100px;
    }
    .hero-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 60px;
      align-items: center;
    }
    .hero h1 {
      font-size: 52px;
      line-height: 1.1;
      margin-bottom: 24px;
      color: var(--bc-primary);
    }
    .hero h1 span { color: var(--bc-accent); }
    .hero-sub {
      font-size: 18px;
      line-height: 1.7;
      color: #555;
      margin-bottom: 16px;
    }
    .hero-trust {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 32px;
      font-size: 15px;
      color: var(--bc-accent);
      font-weight: 600;
    }
    .hero-trust svg { flex-shrink: 0; }
    .hero-actions { display: flex; gap: 16px; align-items: center; flex-wrap: wrap; }
    .btn-primary {
      display: inline-block;
      background: var(--bc-primary);
      color: var(--bc-white);
      padding: 18px 40px;
      border-radius: 40px;
      font-size: 15px;
      font-weight: 600;
      text-decoration: none;
      letter-spacing: 0.02em;
      transition: all 0.25s;
      border: none;
      cursor: pointer;
    }
    .btn-primary:hover { opacity: 0.88; transform: translateY(-1px); }
    .btn-secondary {
      display: inline-block;
      color: var(--bc-primary);
      padding: 18px 24px;
      font-size: 15px;
      font-weight: 600;
      text-decoration: none;
      border-bottom: 2px solid var(--bc-accent);
      transition: color 0.2s;
    }
    .btn-secondary:hover { color: var(--bc-accent); }
    .hero-image {
      width: 100%;
      border-radius: 16px;
      box-shadow: 0 30px 60px rgba(0,0,0,0.1);
    }

    /* ── Trust Bar ── */
    .trust-bar {
      background: var(--bc-white);
      border-bottom: 1px solid rgba(0,0,0,0.06);
      padding: 28px 0;
    }
    .trust-bar-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
      text-align: center;
    }
    .trust-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
    }
    .trust-item svg { color: var(--bc-accent); }
    .trust-item span {
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: #444;
    }

    /* ── Problem Section ── */
    .problem-section { padding: 100px 0; background: var(--bc-white); }
    .problem-section h2 {
      font-size: 42px;
      text-align: center;
      margin-bottom: 24px;
    }
    .problem-body {
      text-align: center;
      font-size: 18px;
      color: #555;
      max-width: 720px;
      margin: 0 auto 48px;
      line-height: 1.8;
    }
    .pain-points {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      max-width: 800px;
      margin: 0 auto 48px;
    }
    .pain-point {
      display: flex;
      align-items: flex-start;
      gap: 14px;
      padding: 20px 24px;
      background: #FFF5F5;
      border-radius: 12px;
      font-size: 15px;
      line-height: 1.5;
      color: #444;
    }
    .pain-point svg { flex-shrink: 0; margin-top: 2px; }
    .problem-transition {
      text-align: center;
      font-family: 'Playfair Display', serif;
      font-size: 28px;
      font-style: italic;
      color: var(--bc-accent);
      margin-top: 16px;
    }

    /* ── Benefits ── */
    .benefits-section { padding: 100px 0; background: var(--bc-bg); }
    .benefit-block {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 80px;
      align-items: center;
      margin-bottom: 80px;
    }
    .benefit-block:last-child { margin-bottom: 0; }
    .benefit-block:nth-child(even) { direction: rtl; }
    .benefit-block:nth-child(even) > * { direction: ltr; }
    .benefit-label {
      font-family: 'Montserrat', sans-serif;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--bc-accent);
      margin-bottom: 12px;
    }
    .benefit-content h3 {
      font-size: 36px;
      margin-bottom: 20px;
      line-height: 1.2;
    }
    .benefit-content p {
      font-size: 17px;
      color: #555;
      line-height: 1.8;
    }
    .benefit-visual {
      background: var(--bc-secondary);
      border-radius: 20px;
      height: 400px;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
    }
    .benefit-icon-large {
      width: 120px;
      height: 120px;
      color: var(--bc-accent);
      opacity: 0.3;
    }

    /* ── Product Details ── */
    .product-section {
      padding: 100px 0;
      background: var(--bc-primary);
      color: var(--bc-white);
    }
    .product-section h2 {
      font-size: 42px;
      color: var(--bc-white);
      text-align: center;
      margin-bottom: 60px;
    }
    .product-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 60px;
    }
    .product-features {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }
    .feature-row {
      display: flex;
      justify-content: space-between;
      padding: 16px 0;
      border-bottom: 1px solid rgba(255,255,255,0.12);
      font-size: 15px;
    }
    .feature-label {
      color: rgba(255,255,255,0.6);
      font-weight: 500;
    }
    .feature-value {
      color: var(--bc-white);
      font-weight: 600;
      text-align: right;
    }
    .product-right h3 {
      color: var(--bc-white);
      font-size: 28px;
      margin-bottom: 24px;
    }
    .color-swatches {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-bottom: 32px;
    }
    .color-tag {
      padding: 8px 16px;
      border: 1px solid rgba(255,255,255,0.2);
      border-radius: 30px;
      font-size: 13px;
      color: rgba(255,255,255,0.8);
    }
    .size-cards {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
      margin-bottom: 32px;
    }
    .size-card {
      background: rgba(255,255,255,0.08);
      border: 1px solid rgba(255,255,255,0.12);
      border-radius: 12px;
      padding: 20px;
      text-align: center;
    }
    .size-name {
      font-family: 'Montserrat', sans-serif;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.6);
      margin-bottom: 8px;
    }
    .size-price {
      font-family: 'Playfair Display', serif;
      font-size: 28px;
      font-weight: 700;
      color: var(--bc-white);
    }
    .size-original {
      font-size: 14px;
      color: rgba(255,255,255,0.4);
      text-decoration: line-through;
      margin-top: 4px;
    }
    .product-cta-wrap { text-align: center; margin-top: 40px; }
    .btn-accent {
      display: inline-block;
      background: var(--bc-accent);
      color: var(--bc-white);
      padding: 20px 48px;
      border-radius: 40px;
      font-size: 16px;
      font-weight: 700;
      text-decoration: none;
      letter-spacing: 0.02em;
      transition: all 0.25s;
    }
    .btn-accent:hover { opacity: 0.9; transform: translateY(-1px); }

    /* ── Comparison ── */
    .comparison-section { padding: 100px 0; background: var(--bc-white); }
    .comparison-section h2 {
      font-size: 42px;
      text-align: center;
      margin-bottom: 60px;
    }
    .comparison-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 15px;
    }
    .comparison-table thead th {
      padding: 16px 20px;
      text-align: left;
      font-family: 'Montserrat', sans-serif;
      font-weight: 700;
      font-size: 12px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: #888;
      border-bottom: 2px solid var(--bc-primary);
    }
    .comparison-table thead th:nth-child(2) {
      color: var(--bc-accent);
      background: var(--bc-secondary);
      border-radius: 12px 12px 0 0;
    }
    .comparison-table tbody td {
      padding: 16px 20px;
      border-bottom: 1px solid #f0f0f0;
      color: #555;
    }
    .comparison-table tbody td:first-child {
      font-weight: 600;
      color: var(--bc-primary);
    }
    .comparison-table tbody td:nth-child(2) {
      background: var(--bc-secondary);
      color: var(--bc-primary);
      font-weight: 600;
    }

    /* ── Reviews ── */
    .reviews-section { padding: 100px 0; background: var(--bc-bg); }
    .reviews-section h2 {
      font-size: 42px;
      text-align: center;
      margin-bottom: 12px;
    }
    .reviews-sub {
      text-align: center;
      font-size: 18px;
      color: #555;
      margin-bottom: 60px;
    }
    .reviews-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }
    .review-card {
      background: var(--bc-white);
      border-radius: 16px;
      padding: 32px;
      box-shadow: 0 4px 20px rgba(0,0,0,0.04);
    }
    .review-stars { color: var(--bc-accent); font-size: 18px; margin-bottom: 12px; }
    .review-title {
      font-family: 'Playfair Display', serif;
      font-size: 18px;
      font-weight: 700;
      margin-bottom: 12px;
      color: var(--bc-primary);
    }
    .review-body {
      font-size: 15px;
      color: #555;
      line-height: 1.7;
      margin-bottom: 20px;
    }
    .review-meta {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 13px;
      color: #888;
      border-top: 1px solid #f0f0f0;
      padding-top: 16px;
    }
    .review-name { font-weight: 700; color: var(--bc-primary); }
    .review-verified {
      display: flex;
      align-items: center;
      gap: 4px;
      color: #22C55E;
      font-weight: 600;
    }

    /* ── Safety Section ── */
    .safety-section { padding: 100px 0; background: var(--bc-secondary); }
    .safety-section h2 {
      font-size: 42px;
      text-align: center;
      margin-bottom: 12px;
    }
    .safety-sub {
      text-align: center;
      font-size: 17px;
      color: #555;
      margin-bottom: 60px;
    }
    .safety-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
      max-width: 900px;
      margin: 0 auto;
    }
    .safety-item {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 16px 20px;
      background: var(--bc-white);
      border-radius: 12px;
      font-size: 14px;
      font-weight: 600;
      color: var(--bc-primary);
    }
    .safety-item svg { color: #22C55E; flex-shrink: 0; }

    /* ── FAQ ── */
    .faq-section { padding: 100px 0; background: var(--bc-white); }
    .faq-section h2 {
      font-size: 42px;
      text-align: center;
      margin-bottom: 60px;
    }
    .faq-list { max-width: 800px; margin: 0 auto; }
    .faq-item {
      border-bottom: 1px solid #e8e8e8;
    }
    .faq-item summary {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 24px 0;
      font-family: 'Playfair Display', serif;
      font-size: 19px;
      font-weight: 600;
      color: var(--bc-primary);
      cursor: pointer;
      list-style: none;
    }
    .faq-item summary::-webkit-details-marker { display: none; }
    .faq-item summary::after {
      content: "+";
      font-family: 'Montserrat', sans-serif;
      font-size: 24px;
      font-weight: 300;
      color: var(--bc-accent);
      transition: transform 0.3s;
    }
    .faq-item[open] summary::after {
      content: "−";
    }
    .faq-answer {
      padding: 0 0 24px;
      font-size: 16px;
      color: #555;
      line-height: 1.8;
    }

    /* ── Final CTA ── */
    .final-cta-section {
      padding: 100px 0;
      background: var(--bc-primary);
      text-align: center;
    }
    .final-cta-section h2 {
      font-size: 48px;
      color: var(--bc-white);
      margin-bottom: 20px;
    }
    .final-cta-body {
      font-size: 18px;
      color: rgba(255,255,255,0.7);
      margin-bottom: 12px;
      max-width: 600px;
      margin-left: auto;
      margin-right: auto;
    }
    .final-promo {
      font-size: 15px;
      color: var(--bc-accent);
      font-weight: 600;
      margin-bottom: 36px;
    }
    .final-promo .promo-code {
      background: var(--bc-accent);
      color: var(--bc-white);
      padding: 4px 12px;
      border-radius: 4px;
      font-weight: 700;
      margin-left: 4px;
    }

    /* ── Footer ── */
    .bc-footer {
      background: var(--bc-primary);
      border-top: 1px solid rgba(255,255,255,0.08);
      padding: 40px 0;
    }
    .footer-inner {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .footer-left {
      display: flex;
      align-items: center;
      gap: 20px;
    }
    .footer-left img { height: 24px; filter: brightness(0) invert(1); }
    .footer-tagline {
      font-family: 'Playfair Display', serif;
      font-style: italic;
      font-size: 14px;
      color: rgba(255,255,255,0.5);
    }
    .footer-links {
      display: flex;
      gap: 24px;
    }
    .footer-links a {
      font-size: 13px;
      color: rgba(255,255,255,0.5);
      text-decoration: none;
      transition: color 0.2s;
    }
    .footer-links a:hover { color: var(--bc-accent); }
    .footer-copyright {
      text-align: center;
      margin-top: 24px;
      font-size: 12px;
      color: rgba(255,255,255,0.3);
    }

    /* ── Sticky Mobile CTA ── */
    .sticky-cta {
      display: none;
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      background: var(--bc-white);
      border-top: 1px solid rgba(0,0,0,0.08);
      padding: 12px 20px;
      z-index: 200;
      box-shadow: 0 -4px 20px rgba(0,0,0,0.08);
    }
    .sticky-inner {
      display: flex;
      justify-content: space-between;
      align-items: center;
      max-width: 1200px;
      margin: 0 auto;
    }
    .sticky-price {
      font-family: 'Playfair Display', serif;
      font-size: 22px;
      font-weight: 700;
    }
    .sticky-price .original {
      font-size: 14px;
      color: #999;
      text-decoration: line-through;
      margin-left: 8px;
      font-family: 'Montserrat', sans-serif;
    }
    .sticky-btn {
      background: var(--bc-primary);
      color: var(--bc-white);
      padding: 14px 32px;
      border-radius: 40px;
      font-size: 14px;
      font-weight: 700;
      text-decoration: none;
      border: none;
      cursor: pointer;
    }

    /* ── Responsive ── */
    @media (max-width: 1024px) {
      .hero h1 { font-size: 40px; }
      .hero-grid { gap: 40px; }
      .benefit-block { gap: 40px; }
      .benefit-content h3 { font-size: 28px; }
      .product-grid { gap: 40px; }
    }

    @media (max-width: 768px) {
      .hero { padding: 50px 0 60px; }
      .hero-grid {
        grid-template-columns: 1fr;
        gap: 32px;
      }
      .hero h1 { font-size: 34px; }
      .hero-sub { font-size: 16px; }
      .hero-image { order: -1; }
      .hero-actions { flex-direction: column; align-items: stretch; text-align: center; }

      .trust-bar-grid {
        grid-template-columns: 1fr 1fr;
        gap: 16px;
      }

      .problem-section h2,
      .benefits-section h2,
      .comparison-section h2,
      .reviews-section h2,
      .safety-section h2,
      .faq-section h2,
      .product-section h2 { font-size: 30px; }

      .pain-points { grid-template-columns: 1fr; }

      .benefit-block {
        grid-template-columns: 1fr;
        gap: 32px;
        margin-bottom: 60px;
      }
      .benefit-block:nth-child(even) { direction: ltr; }
      .benefit-visual { height: 280px; }

      .product-grid { grid-template-columns: 1fr; }
      .size-cards { grid-template-columns: repeat(3, 1fr); }

      .comparison-table { font-size: 13px; }
      .comparison-table th,
      .comparison-table td { padding: 12px 10px; }

      .reviews-grid {
        grid-template-columns: 1fr;
        gap: 16px;
      }

      .safety-grid {
        grid-template-columns: 1fr 1fr;
        gap: 12px;
      }

      .final-cta-section h2 { font-size: 32px; }
      .final-cta-body { font-size: 16px; }

      .footer-inner { flex-direction: column; gap: 20px; text-align: center; }
      .footer-links { flex-wrap: wrap; justify-content: center; }

      .sticky-cta { display: block; }
      body { padding-bottom: 70px; }
    }

    @media (max-width: 480px) {
      .hero h1 { font-size: 28px; }
      .size-cards { grid-template-columns: 1fr; gap: 12px; }
      .safety-grid { grid-template-columns: 1fr; }
      .promo-banner { font-size: 12px; padding: 10px 16px; }
    }

    /* ── Animations ── */
    .fade-up {
      opacity: 0;
      transform: translateY(30px);
      transition: opacity 0.6s ease, transform 0.6s ease;
    }
    .fade-up.visible {
      opacity: 1;
      transform: translateY(0);
    }
  </style>
</head>

<body>
  <!-- Promo Banner -->
  <div class="promo-banner">
    <%= page.content.promo.banner %> &mdash; Use Code <span class="promo-code"><%= page.content.promo.code %></span>
  </div>

  <!-- Navigation -->
  <nav class="bc-nav">
    <div class="container">
      <a href="<%= ctaUrl %>">
        <img src="<%= client.logo %>" alt="<%= client.name %>" loading="eager">
      </a>
      <a href="<%= ctaUrl %>" class="nav-cta"><%= page.content.hero.cta_text %></a>
    </div>
  </nav>

  <!-- Hero Section -->
  <section class="hero" id="top">
    <div class="container">
      <div class="hero-grid">
        <div class="fade-up">
          <div class="hero-trust">
            <svg width="20" height="20" fill="none" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" fill="currentColor"/></svg>
            <%= page.content.hero.trust_signal %>
          </div>
          <h1>The Cooling Duvet Cover <span>5,000+ Hot Sleepers</span> Swear By</h1>
          <p class="hero-sub"><%= page.content.hero.subheadline %></p>
          <div class="hero-actions">
            <a href="<%= ctaUrl %>" class="btn-primary"><%= page.content.hero.cta_text %></a>
            <a href="<%= page.content.hero.secondary_cta_href %>" class="btn-secondary"><%= page.content.hero.secondary_cta_text %></a>
          </div>
        </div>
        <div class="fade-up">
          <img src="<%= page.content.hero.product_image %>" alt="Bella Coterie Luxury Bamboo Duvet Cover Set" class="hero-image" loading="eager" fetchpriority="high">
        </div>
      </div>
    </div>
  </section>

  <!-- Trust Bar -->
  <section class="trust-bar">
    <div class="container">
      <div class="trust-bar-grid">
        <% page.content.trust_bar.forEach(function(item) { %>
        <div class="trust-item">
          <% if (item.icon === 'shield') { %>
          <svg width="28" height="28" fill="none" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <% } else if (item.icon === 'star') { %>
          <svg width="28" height="28" fill="none" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" stroke="currentColor" stroke-width="1.5" fill="none"/></svg>
          <% } else if (item.icon === 'truck') { %>
          <svg width="28" height="28" fill="none" viewBox="0 0 24 24"><path d="M1 3h15v13H1zM16 8h4l3 3v5h-7V8z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><circle cx="5.5" cy="18.5" r="2.5" stroke="currentColor" stroke-width="1.5"/><circle cx="18.5" cy="18.5" r="2.5" stroke="currentColor" stroke-width="1.5"/></svg>
          <% } else if (item.icon === 'refresh') { %>
          <svg width="28" height="28" fill="none" viewBox="0 0 24 24"><path d="M1 4v6h6M23 20v-6h-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M20.49 9A9 9 0 005.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 013.51 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <% } %>
          <span><%= item.text %></span>
        </div>
        <% }); %>
      </div>
    </div>
  </section>

  <!-- Problem Section -->
  <section class="problem-section">
    <div class="container">
      <div class="fade-up">
        <h2><%= page.content.problem_section.headline %></h2>
        <p class="problem-body"><%= page.content.problem_section.body %></p>
      </div>
      <div class="pain-points fade-up">
        <% page.content.problem_section.pain_points.forEach(function(point) { %>
        <div class="pain-point">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="#E53E3E" stroke-width="1.5"/><path d="M15 9l-6 6M9 9l6 6" stroke="#E53E3E" stroke-width="1.5" stroke-linecap="round"/></svg>
          <%= point %>
        </div>
        <% }); %>
      </div>
      <p class="problem-transition fade-up"><%= page.content.problem_section.transition %></p>
    </div>
  </section>

  <!-- Benefits Section -->
  <section class="benefits-section">
    <div class="container">
      <% page.content.benefits.forEach(function(benefit) { %>
      <div class="benefit-block fade-up">
        <div class="benefit-content">
          <div class="benefit-label"><%= benefit.title %></div>
          <h3><%= benefit.headline %></h3>
          <p><%= benefit.body %></p>
        </div>
        <div class="benefit-visual">
          <% if (benefit.image === 'cooling') { %>
          <svg class="benefit-icon-large" viewBox="0 0 24 24" fill="none"><path d="M12 2v20M17 7l-5 5-5-5M2 12h20M7 17l5-5 5 5" stroke="currentColor" stroke-width="1" stroke-linecap="round"/></svg>
          <% } else if (benefit.image === 'softness') { %>
          <svg class="benefit-icon-large" viewBox="0 0 24 24" fill="none"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z" stroke="currentColor" stroke-width="1"/></svg>
          <% } else if (benefit.image === 'certified') { %>
          <svg class="benefit-icon-large" viewBox="0 0 24 24" fill="none"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke="currentColor" stroke-width="1"/><path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="1" stroke-linecap="round"/></svg>
          <% } %>
        </div>
      </div>
      <% }); %>
    </div>
  </section>

  <!-- Product Details -->
  <section class="product-section" id="product">
    <div class="container">
      <h2><%= page.content.product_details.headline %></h2>
      <div class="product-grid">
        <div class="product-features">
          <% page.content.product_details.features.forEach(function(feat) { %>
          <div class="feature-row">
            <span class="feature-label"><%= feat.label %></span>
            <span class="feature-value"><%= feat.value %></span>
          </div>
          <% }); %>
        </div>
        <div class="product-right">
          <h3>11 Colors Available</h3>
          <div class="color-swatches">
            <% page.content.product_details.colors.forEach(function(color) { %>
            <span class="color-tag"><%= color %></span>
            <% }); %>
          </div>
          <div class="size-cards">
            <% page.content.product_details.sizes.forEach(function(size) { %>
            <div class="size-card">
              <div class="size-name"><%= size.name %></div>
              <div class="size-price"><%= size.price %></div>
              <div class="size-original"><%= size.original %></div>
            </div>
            <% }); %>
          </div>
        </div>
      </div>
      <div class="product-cta-wrap">
        <a href="<%= ctaUrl %>" class="btn-accent"><%= page.content.hero.cta_text %></a>
      </div>
    </div>
  </section>

  <!-- Comparison Table -->
  <section class="comparison-section">
    <div class="container">
      <h2 class="fade-up"><%= page.content.comparison.headline %></h2>
      <div class="fade-up" style="overflow-x: auto;">
        <table class="comparison-table">
          <thead>
            <tr>
              <% page.content.comparison.columns.forEach(function(col) { %>
              <th><%= col %></th>
              <% }); %>
            </tr>
          </thead>
          <tbody>
            <% page.content.comparison.rows.forEach(function(row) { %>
            <tr>
              <% row.forEach(function(cell) { %>
              <td><%= cell %></td>
              <% }); %>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Reviews -->
  <section class="reviews-section" id="reviews">
    <div class="container">
      <h2 class="fade-up"><%= page.content.reviews.headline %></h2>
      <p class="reviews-sub fade-up"><%= page.content.reviews.subheadline %></p>
      <div class="reviews-grid">
        <% page.content.reviews.testimonials.forEach(function(review) { %>
        <div class="review-card fade-up">
          <div class="review-stars">
            <% for (var i = 0; i < review.rating; i++) { %>&#9733;<% } %>
          </div>
          <div class="review-title"><%= review.title %></div>
          <div class="review-body"><%= review.body %></div>
          <div class="review-meta">
            <div>
              <span class="review-name"><%= review.name %></span>
              <span style="margin-left: 8px; font-size: 12px; color: #aaa;"><%= review.variant %></span>
            </div>
            <% if (review.verified) { %>
            <span class="review-verified">
              <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              Verified
            </span>
            <% } %>
          </div>
        </div>
        <% }); %>
      </div>
    </div>
  </section>

  <!-- Safety / OEKO-TEX Section -->
  <section class="safety-section">
    <div class="container">
      <h2 class="fade-up"><%= page.content.safety_section.headline %></h2>
      <p class="safety-sub fade-up"><%= page.content.safety_section.subheadline %></p>
      <div class="safety-grid fade-up">
        <% page.content.safety_section.items.forEach(function(item) { %>
        <div class="safety-item">
          <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <%= item %>
        </div>
        <% }); %>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="faq-section" id="faq">
    <div class="container-narrow">
      <h2 class="fade-up"><%= page.content.faq.headline %></h2>
      <div class="faq-list fade-up">
        <% page.content.faq.items.forEach(function(item) { %>
        <details class="faq-item">
          <summary><%= item.q %></summary>
          <div class="faq-answer"><%= item.a %></div>
        </details>
        <% }); %>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="final-cta-section">
    <div class="container">
      <h2 class="fade-up"><%= page.content.final_cta.headline %></h2>
      <p class="final-cta-body fade-up"><%= page.content.final_cta.body %></p>
      <p class="final-promo fade-up"><%= page.content.final_cta.promo_reminder.replace('BESTDEAL', '') %><span class="promo-code">BESTDEAL</span></p>
      <a href="<%= ctaUrl %>" class="btn-accent fade-up"><%= page.content.final_cta.cta_text %></a>
    </div>
  </section>

  <!-- Footer -->
  <footer class="bc-footer">
    <div class="container">
      <div class="footer-inner">
        <div class="footer-left">
          <img src="<%= client.logo %>" alt="<%= client.name %>">
          <span class="footer-tagline"><%= page.content.footer.tagline %></span>
        </div>
        <div class="footer-links">
          <% page.content.footer.links.forEach(function(link) { %>
          <a href="<%= link.href %>"><%= link.label %></a>
          <% }); %>
        </div>
      </div>
      <div class="footer-copyright">&copy; <%= page.content.footer.copyright %></div>
    </div>
  </footer>

  <!-- Sticky Mobile CTA -->
  <div class="sticky-cta" id="stickyCta">
    <div class="sticky-inner">
      <div class="sticky-price">
        $119.99 <span class="original">$149.99</span>
      </div>
      <a href="<%= ctaUrl %>" class="sticky-btn">Shop Now</a>
    </div>
  </div>

  <!-- Scroll Animation Script -->
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      var els = document.querySelectorAll('.fade-up');
      if ('IntersectionObserver' in window) {
        var obs = new IntersectionObserver(function(entries) {
          entries.forEach(function(e) {
            if (e.isIntersecting) { e.target.classList.add('visible'); obs.unobserve(e.target); }
          });
        }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
        els.forEach(function(el) { obs.observe(el); });
      } else {
        els.forEach(function(el) { el.classList.add('visible'); });
      }

      // Sticky CTA visibility
      var hero = document.getElementById('top');
      if (hero && window.innerWidth <= 768) {
        var stickyObs = new IntersectionObserver(function(entries) {
          var sticky = document.getElementById('stickyCta');
          if (sticky) sticky.style.display = entries[0].isIntersecting ? 'none' : 'block';
        });
        stickyObs.observe(hero);
      }
    });
  </script>
</body>
</html>
