  <style>
    body { font-family: 'Montserrat', sans-serif; }
    h1, h2, h3, h4, h5 { font-family: 'Merriweather', Georgia, serif; }
    .x-icon::before {
      content: "✕";
      color: #BF4E30;
      font-weight: 700;
      margin-right: 10px;
    }
    .check-icon::before {
      content: "✓";
      color: #439A86;
      font-weight: 700;
      margin-right: 10px;
    }
    .skew-section {
      position: relative;
      overflow: hidden;
    }
    .skew-section::before {
      content: '';
      position: absolute;
      top: -30px;
      left: 0;
      right: 0;
      height: 60px;
      background: inherit;
      transform: skewY(-2deg);
      transform-origin: top left;
      z-index: -1;
    }
    details summary::-webkit-details-marker { display: none; }
    details summary { list-style: none; }
  </style>

  <!-- JSON-LD -->
  <script type="application/ld+json">
