  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: {
              yellow: '#e9d985',
              green: '#439A86',
              orange: '#BF4E30',
              teal: '#3F8F7F',
              cream: '#FBF5E7',
