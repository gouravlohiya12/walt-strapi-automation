{
  "version": 2,
  "builds": [
    {
      "src": "frontend/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/images/(.*)",
      "dest": "frontend/public/images/$1"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/server.js"
    }
  ]
}
